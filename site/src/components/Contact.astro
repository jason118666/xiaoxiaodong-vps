---
// 联系小小东：card 用在首页、常见问题末尾（二维码直接显示）；fold 接在每页末尾的反馈入口下面（点开才显示二维码）
import { langOf } from "../data/nav.js";
interface Props { variant?: "card" | "fold" }
const { variant = "card" } = Astro.props;
const en = langOf(Astro.url.pathname) === "en";
const QR = "https://vip.xiaoxiaodong.ai/site-assets/wechat-qr.png";
const T = en
  ? {
      h: "Need help?",
      p: "Confused, not sure what to do, or stuck on a problem that won't go away? Add Xiaoxiaodong on WeChat.",
      cap: "Scan with WeChat",
      mobile: "On a phone: long-press to save, then scan it from your photos in WeChat.",
      alt: "Xiaoxiaodong's WeChat QR code",
      foldQ: "Need help?",
      foldA: "Add Xiaoxiaodong on WeChat",
    }
  : {
      h: "需要帮忙？",
      p: "看不懂、不会操作，或者问题一直解决不了，直接加小小东微信。",
      cap: "微信扫码添加",
      mobile: "手机上：长按保存图片，再用微信扫一扫从相册识别。",
      alt: "小小东的微信二维码",
      foldQ: "需要帮忙？",
      foldA: "加小小东微信",
    };
---
{variant === "card" ? (
  <section class="contact" aria-labelledby="h-contact">
    <div class="contact__text">
      <h2 id="h-contact">{T.h}</h2>
      <p>{T.p}</p>
    </div>
    <figure class="contact__qr">
      <img src={QR} width="160" height="165" alt={T.alt} loading="lazy" decoding="async" />
      <figcaption>{T.cap}<span class="contact__mobile">{T.mobile}</span></figcaption>
    </figure>
  </section>
) : (
  <details class="contact-fold">
    <summary>{T.foldQ}<span>{T.foldA}</span></summary>
    <div class="contact-fold__body">
      <img src={QR} width="132" height="136" alt={T.alt} loading="lazy" decoding="async" />
      <div>
        <p>{T.p}</p>
        <p class="contact__mobile">{T.mobile}</p>
      </div>
    </div>
  </details>
)}
